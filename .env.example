# ─────────────────────────────────────────────────────────────
# Bookmatch 환경변수
# 로컬 개발: 이 파일을 .env.local 로 복사해서 값을 채우세요.
# 배포(Vercel): 프로젝트 Settings → Environment Variables 에 그대로 추가하세요.
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API 키 (서버 전용, 브라우저 노출 금지)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=

# 카카오 REST API 키 (서버 전용, 책 표지 이미지 검색용)
# https://developers.kakao.com/ → 내 애플리케이션 → REST API 키
KAKAO_API_KEY=

# 서비스 기본 URL (친구 초대 링크 생성에 사용, NEXT_PUBLIC_ 이라 브라우저에 노출됨)
# 로컬: http://localhost:3000  /  배포: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# 수익화: 제휴(어필리에이트) 링크  ─ 전부 선택 사항
# 비워두면 제휴 없는 일반 검색 링크로 동작합니다.
# 제휴 승인 후 여기에 값만 채우면 전 서점 버튼이 제휴 링크로 바뀝니다.
# 링크 템플릿에는 검색어 자리표시자 {query} 를 넣으세요 (자동 치환됨).
# ─────────────────────────────────────────────────────────────

# 쿠팡 파트너스
#  기본값으로 코드에 AF8666448 이 들어가 있습니다. 다른 ID 를 쓰려면 여기서 덮어쓰세요.
#  링크 형식: /np/search?q={책제목}&channel=user&affiliate={이 ID}
NEXT_PUBLIC_COUPANG_AFFILIATE_ID=AF8666448
#  (선택) 파트너스에서 발급한 딥링크/추적 URL 전체를 쓰려면 템플릿으로 넣습니다. (위보다 우선)
NEXT_PUBLIC_COUPANG_LINK_TEMPLATE=

# 예스24 (제휴 네트워크 또는 파트너 링크 템플릿)
NEXT_PUBLIC_YES24_LINK_TEMPLATE=

# 교보문고 (제휴 네트워크 또는 파트너 링크 템플릿)
NEXT_PUBLIC_KYOBO_LINK_TEMPLATE=
