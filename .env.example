# ─────────────────────────────────────────────────────────────
# 다시(DASI) 환경변수
# 로컬 개발: 이 파일을 .env.local 로 복사해서 값을 채우세요.
# 배포(Vercel): 프로젝트 Settings → Environment Variables 에 그대로 추가하세요.
#
# ※ API 키가 하나도 없어도 앱은 동작합니다.
#    ANTHROPIC_API_KEY 가 비어 있으면 무료 모드로 샘플 추천을 돌려줍니다(비용 0).
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API 키 (서버 전용, 브라우저 노출 금지)
# 비워두면 무료 모드(샘플 추천)로 동작. 채우면 Claude 가 실제 추천을 생성합니다.
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=

# 알라딘 Open API TTB 키 (서버 전용, 표지·판매가·구매링크)
# 코드에 기본값(ttbya07361549001)이 있어 비워둬도 동작하지만, 본인 키 사용 권장.
# https://www.aladin.co.kr/ttb/wblog_manage.aspx 에서 발급
ALADIN_TTB_KEY=ttbya07361549001

# 쿠팡 파트너스 ID (브라우저 노출됨 · NEXT_PUBLIC_)
# 결과 화면의 쿠팡 구매 링크에 사용: /np/search?q={제목}&channel=user&affiliate={이 ID}
# 코드에 기본값(AF8666448)이 있어 비워둬도 동작합니다.
NEXT_PUBLIC_COUPANG_ID=AF8666448

# 서비스 기본 URL (브라우저 노출됨 · NEXT_PUBLIC_)
# 로컬: http://localhost:3000  /  배포: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
